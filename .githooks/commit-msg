#!/bin/sh
# Rejects commit messages that do not follow Conventional Commits 1.0.0.
# Enabled by `git config core.hooksPath .githooks` (run by `composer setup`).

header=$(grep -v '^#' "$1" | head -n 1)

# Allow messages generated by git itself.
case "$header" in
    Merge\ *|Revert\ \"*|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

types='feat|fix|refactor|perf|test|docs|style|build|ci|chore|revert'
pattern="^($types)(\([a-z0-9-]+\))?!?: [a-z0-9].*[^.]$"

if ! printf '%s' "$header" | grep -Eq "$pattern"; then
    echo "commit-msg: header must match '<type>(<optional scope>): <description>'" >&2
    echo "  types: $types" >&2
    echo "  description: imperative, lowercase start, no trailing period" >&2
    echo "  got: $header" >&2
    exit 1
fi

if [ "${#header}" -gt 72 ]; then
    echo "commit-msg: header is ${#header} characters, max is 72" >&2
    exit 1
fi
